# Port for Express server (default: 3000)
PORT=3000

# Path to SQLite database file (on VPS e.g. /var/lib/contact-sdmaf/cards.db)
DB_PATH=./data/cards.db

# Optional admin password for the control panel.
# If left empty, the app shows a one-time first-run password setup form in the UI.
ADMIN_PASSWORD=

# Optional scrypt password hash in format "salt:hash" (takes precedence over ADMIN_PASSWORD if set)
ADMIN_PASSWORD_HASH=

# APP_URL: The URL where this applet is hosted.
APP_URL="https://contact.sdmaf.ru"
